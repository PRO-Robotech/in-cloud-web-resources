# Source: incloud-web-resources/templates/CustomColumnsOverride/apiextensions.k8s.io.v1.crd.yaml
apiVersion: front.in-cloud.io/v1alpha1
kind: CustomColumnsOverride
metadata:
  name: stock-cluster-apiextensions.k8s.io.v1.customresourcedefinitions
spec:
  additionalPrinterColumns:
    - jsonPath: .metadata.name
      name: Name
      type: factory
      customProps:
        disableEventBubbling: true
        items:
          - type: antdFlex
            data:
              id: resource-badge-link-row
              direction: row
              align: center
              gap: 6 # расстояние между иконкой и текстом
            children:
              - type: ResourceBadge
                data:
                  id: example-resource-badge
                  value: CustomResourceDefinition

              - type: antdLink
                data:
                  id: -link
                  text: "{reqsJsonPath[0]['.metadata.name']['-']}"
                  href: "/openapi-ui/{2}/factory/crd-details/apiextensions.k8s.io/v1/customresourcedefinitions/{reqsJsonPath[0]['.metadata.name']['-']}"
    - jsonPath: .spec.group
      name: Group
      type: string
    - jsonPath: .status.storedVersions[0]
      name: Latest Version
      type: string
    - jsonPath: .status.conditions[?(@.type=='NamesAccepted')].status
      name: Namespaced
      type: string
    - jsonPath: .status.conditions[?(@.type=='Established')].status
      name: Established
      type: string
  additionalPrinterColumnsTrimLengths:
    - key: Name
      value: 64
  id: stock-cluster-/apiextensions.k8s.io/v1/customresourcedefinitions
---
